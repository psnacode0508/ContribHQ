{
  "name": "contribhq-root",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w client\" \"npm run dev -w server\"",
    "build": "npm run build --workspaces --if-present",
    "generate": "prisma generate --schema=prisma/schema.prisma",
    "migrate": "prisma migrate dev --name add_workspace_card"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prisma": "^5.22.0"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "prisma": true
  }
}
