{
  "name": "contribhq-root",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "prisma"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w client\" \"npm run dev -w server\"",
    "build": "npm run build --workspaces --if-present",
    "generate": "prisma generate --schema=prisma/schema.prisma"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "concurrently": "^10.0.5",
    "prisma": "5"
  }
}
